{
  "name": "@minvws/manon",
  "version": "0.0.0",
  "type": "module",
  "license": "EUPL-1.2",
  "files": [
    "**/*.scss",
    "!**/*.test.scss",
    "**/*.js",
    "!**/*.{config,setup,test}.js",
    "**/*.license",
    "LICENSES",
    "REUSE.toml",
    "README.md"
  ],
  "scripts": {
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint:css": "stylelint \"**/*.scss\"",
    "lint:css:fix": "npm run lint:css -- --fix",
    "check": "tsc",
    "check:watch": "tsc --watch",
    "npm-version": "npm version",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage && npm run coverage:rebase-paths",
    "coverage:rebase-paths": "node -e \"const fs=require('fs'),f='coverage/lcov.info';fs.writeFileSync(f,fs.readFileSync(f,'utf8').replace(/^SF:/gm,'SF:manon/'))\""
  },
  "peerDependencies": {
    "sass": ">=1.77.6"
  },
  "devDependencies": {
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^26.1.2",
    "@vitest/coverage-v8": "^4.1.10",
    "jsdom": "^30.0.1",
    "prettier": "^3.9.6",
    "sass": "^1.99.0",
    "sass-true": "^10.1.0",
    "stylelint": "^17.14.1",
    "stylelint-config-standard-scss": "^17.0.0",
    "vitest": "^4.1.10"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/minvws/nl-rdo-manon.git",
    "directory": "manon"
  }
}
